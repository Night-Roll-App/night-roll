{
  "name": "night-roll",
  "version": "0.0.0",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test --test-force-exit tests/night-roll.test.mjs && node --test tests/nsf.test.mjs && node --test tests/gestures.test.mjs && node --test tests/bridge.test.mjs",
    "bridge": "node tools/claude-bridge.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium -g @smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshcough/night-roll.git"
  },
  "bugs": {
    "url": "https://github.com/joshcough/night-roll/issues"
  },
  "homepage": "https://github.com/joshcough/night-roll#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "private": true
}
